/* Calc add-in functions of 1xVnOffice: DOCSO and DOCTIEN (Vietnamese numbers and amounts in words). */
#ifndef ORG_ONEXVN_TOOLS_XVNSHEETFUNCTIONS_IDL
#define ORG_ONEXVN_TOOLS_XVNSHEETFUNCTIONS_IDL

#include <com/sun/star/uno/XInterface.idl>

module org { module onexvn { module tools {

interface XVnSheetFunctions : com::sun::star::uno::XInterface
{
    /* DOCSO(Number; [Zero]) - Zero is "lẻ" (default) or "linh". */
    string docso( [in] double Number, [in] any Zero );

    /* DOCTIEN(Amount; [Currency]) - Currency defaults to "đồng". */
    string doctien( [in] double Amount, [in] any Currency );
};

}; }; };

#endif
