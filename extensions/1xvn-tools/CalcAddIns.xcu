<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0. Names, help and category of the DOCSO / DOCTIEN sheet functions. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="CalcAddIns" oor:package="org.openoffice.Office">
  <node oor:name="AddInInfo">
    <node oor:name="org.onexvn.tools.SheetFunctions" oor:op="replace">
      <node oor:name="AddInFunctions">
        <node oor:name="docso" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">DOCSO</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Spells out a number in Vietnamese words, e.g. 1205 -> Một nghìn hai trăm lẻ năm.</value>
            <value xml:lang="vi">Đọc số thành chữ tiếng Việt, vd 1205 -> Một nghìn hai trăm lẻ năm.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCSO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Number</value><value xml:lang="vi">Số</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The number to spell out (up to 18 integer digits).</value><value xml:lang="vi">Số cần đọc (tối đa 18 chữ số phần nguyên).</value></prop>
            </node>
            <node oor:name="Zero" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Zero</value><value xml:lang="vi">Lẻ</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">Optional: "lẻ" (default) or "linh", as in 105 = một trăm lẻ năm / linh năm.</value><value xml:lang="vi">Tuỳ chọn: "lẻ" (mặc định) hoặc "linh", vd 105 = một trăm lẻ năm / linh năm.</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="doctien" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">DOCTIEN</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Spells out an amount of money in Vietnamese words, rounded to whole units, e.g. 1250000 -> Một triệu hai trăm năm mươi nghìn đồng.</value>
            <value xml:lang="vi">Đọc số tiền thành chữ, làm tròn tới đơn vị, vd 1250000 -> Một triệu hai trăm năm mươi nghìn đồng.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCTIEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Amount" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Amount</value><value xml:lang="vi">Số tiền</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The amount to spell out.</value><value xml:lang="vi">Số tiền cần đọc.</value></prop>
            </node>
            <node oor:name="Currency" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Currency</value><value xml:lang="vi">Đơn vị</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">Optional currency word, default "đồng".</value><value xml:lang="vi">Tuỳ chọn: đơn vị tiền, mặc định "đồng".</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="tachho" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">TACHHO</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Returns the family name of a Vietnamese full name, e.g. Nguyễn Thị Ánh Nguyệt -> Nguyễn.</value>
            <value xml:lang="vi">Trả về họ trong họ tên, vd Nguyễn Thị Ánh Nguyệt -> Nguyễn.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHHO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="FullName" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Full name</value><value xml:lang="vi">Họ tên</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The full name, for example "Nguyễn Thị Ánh Nguyệt".</value><value xml:lang="vi">Họ tên đầy đủ, ví dụ "Nguyễn Thị Ánh Nguyệt".</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="tachdem" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">TACHDEM</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Returns the middle name, e.g. Nguyễn Thị Ánh Nguyệt -> Thị Ánh.</value>
            <value xml:lang="vi">Trả về tên đệm, vd Nguyễn Thị Ánh Nguyệt -> Thị Ánh.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHDEM</value></prop>
          <node oor:name="Parameters">
            <node oor:name="FullName" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Full name</value><value xml:lang="vi">Họ tên</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The full name, for example "Nguyễn Thị Ánh Nguyệt".</value><value xml:lang="vi">Họ tên đầy đủ, ví dụ "Nguyễn Thị Ánh Nguyệt".</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="tachten" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">TACHTEN</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Returns the given name, e.g. Nguyễn Thị Ánh Nguyệt -> Nguyệt.</value>
            <value xml:lang="vi">Trả về tên, vd Nguyễn Thị Ánh Nguyệt -> Nguyệt.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHTEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="FullName" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Full name</value><value xml:lang="vi">Họ tên</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The full name, for example "Nguyễn Thị Ánh Nguyệt".</value><value xml:lang="vi">Họ tên đầy đủ, ví dụ "Nguyễn Thị Ánh Nguyệt".</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="sapten" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">SAPTEN</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">A sort key for Vietnamese names: given name first, in Vietnamese letter and tone order. Sort by this column.</value>
            <value xml:lang="vi">Khoá sắp xếp danh sách người Việt: tên trước, đúng thứ tự chữ cái và dấu thanh. Sắp bảng theo cột này.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">SAPTEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="FullName" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Full name</value><value xml:lang="vi">Họ tên</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The full name, for example "Nguyễn Thị Ánh Nguyệt".</value><value xml:lang="vi">Họ tên đầy đủ, ví dụ "Nguyễn Thị Ánh Nguyệt".</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="bodau" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">BODAU</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Removes Vietnamese diacritics: "Đường Lê Lợi" becomes "Duong Le Loi". Useful for file names, codes and e-mail addresses.</value>
            <value xml:lang="vi">Bỏ dấu tiếng Việt: "Đường Lê Lợi" thành "Duong Le Loi". Dùng cho tên tệp, mã số, địa chỉ thư.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">BODAU</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Text</value><value xml:lang="vi">Chữ</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">The text to strip.</value><value xml:lang="vi">Chữ cần bỏ dấu.</value></prop>
            </node>
          </node>
        </node>
        <node oor:name="xungho" oor:op="replace">
          <prop oor:name="DisplayName"><value xml:lang="en-US">XUNGHO</value></prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">A salutation for mail merge: XUNGHO("Nam";"Nguyễn Văn A") gives "Ông Nguyễn Văn A". An unreadable gender gives "Ông/Bà" instead of a guess.</value>
            <value xml:lang="vi">Lời xưng hô cho trộn thư: XUNGHO("Nam";"Nguyễn Văn A") cho "Ông Nguyễn Văn A". Giới tính không đọc được thì trả về "Ông/Bà" thay vì đoán.</value>
          </prop>
          <prop oor:name="Category"><value>Text</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">XUNGHO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Gender" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Gender</value><value xml:lang="vi">Giới tính</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">Nam/Nữ, M/F, Ông/Bà, 1/0.</value><value xml:lang="vi">Nam/Nữ, M/F, Ông/Bà, 1/0.</value></prop>
            </node>
            <node oor:name="FullName" oor:op="replace">
              <prop oor:name="DisplayName"><value xml:lang="en-US">Full name</value><value xml:lang="vi">Họ tên</value></prop>
              <prop oor:name="Description"><value xml:lang="en-US">Optional: the name after the title.</value><value xml:lang="vi">Tuỳ chọn: họ tên đặt sau lời xưng hô.</value></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
