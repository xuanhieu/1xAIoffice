<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0. Menu "Vietnamese" and the add-on toolbar (shown on the ribbon's Extension tab). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.1xvnoffice.tools.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Vietnamese</value><value xml:lang="vi">Tiếng Việt</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="m00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NumberToWords</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Number to Words</value><value xml:lang="vi">Đọc số thành chữ</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:MoneyToWords</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Amount in Words (VND)</value><value xml:lang="vi">Đọc số tiền thành chữ</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:ConvertTCVN3</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Convert TCVN3 to Unicode</value><value xml:lang="vi">Chuyển mã TCVN3 sang Unicode</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NormalizeUnicode</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Normalize Vietnamese Unicode</value><value xml:lang="vi">Chuẩn hóa Unicode tiếng Việt</value></prop>
