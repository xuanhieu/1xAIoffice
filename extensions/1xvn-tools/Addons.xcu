<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0. Menu "Vietnamese" and the add-on toolbar (shown on the ribbon's Extension tab). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.1xvnoffice.tools.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Vietnamese</value><value xml:lang="vi">Tiếng Việt</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="m00a" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:Nd30Document</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">New Administrative Document (Decree 30)...</value><value xml:lang="vi">Văn bản hành chính NĐ30 mới...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NumberToWords</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Number to Words</value><value xml:lang="vi">Đọc số thành chữ</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:MoneyToWords</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Amount in Words (VND)</value><value xml:lang="vi">Đọc số tiền thành chữ</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:ConvertTCVN3</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Convert TCVN3 to Unicode</value><value xml:lang="vi">Chuyển mã TCVN3 sang Unicode</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NormalizeUnicode</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Normalize Vietnamese Unicode</value><value xml:lang="vi">Chuẩn hóa Unicode tiếng Việt</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:RemoveDiacritics</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Remove Vietnamese Diacritics</value><value xml:lang="vi">Bỏ dấu tiếng Việt</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
        </node>
      </node>
    </node>
    <!-- Ribbon: the Vietnamese commands are merged into the Home tab by the NotebookBarAddonsToolMergePoint that
         scripts/ui/ribbon.py moves there from the (hidden) Extension tab. Title is the button label; Context limits
         each command to the modules that can run it. -->
    <node oor:name="OfficeNotebookBar">
      <node oor:name="org.1xvnoffice.tools.ribbon" oor:op="replace">
        <node oor:name="m00a" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:Nd30Document</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Decree 30 document</value><value xml:lang="vi">Văn bản NĐ30</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="m00" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NumberToWords</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Number to words</value><value xml:lang="vi">Đọc số</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="m01" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:MoneyToWords</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Amount in words</value><value xml:lang="vi">Đọc tiền</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="m02" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:ConvertTCVN3</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">TCVN3 to Unicode</value><value xml:lang="vi">Mã TCVN3</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="m03" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NormalizeUnicode</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Normalize Vietnamese</value><value xml:lang="vi">Chuẩn hoá</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="m04" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:RemoveDiacritics</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Remove diacritics</value><value xml:lang="vi">Bỏ dấu</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
      </node>
    </node>
    <!-- Button icons, generated by scripts/brand/make-brand.py (option fluent) into icons/. -->
    <node oor:name="Images">
    <node oor:name="img_Nd30Document" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:Nd30Document</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/Nd30Document_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/Nd30Document_26.svg</value></prop>
      </node>
    </node>
    <node oor:name="img_NumberToWords" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NumberToWords</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/NumberToWords_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/NumberToWords_26.svg</value></prop>
      </node>
    </node>
    <node oor:name="img_MoneyToWords" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:MoneyToWords</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/MoneyToWords_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/MoneyToWords_26.svg</value></prop>
      </node>
    </node>
    <node oor:name="img_ConvertTCVN3" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:ConvertTCVN3</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/ConvertTCVN3_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/ConvertTCVN3_26.svg</value></prop>
      </node>
    </node>
    <node oor:name="img_NormalizeUnicode" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:NormalizeUnicode</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/NormalizeUnicode_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/NormalizeUnicode_26.svg</value></prop>
      </node>
    </node>
    <node oor:name="img_RemoveDiacritics" oor:op="replace">
      <prop oor:name="URL" oor:type="xs:string"><value>vnd.1x.tools:RemoveDiacritics</value></prop>
      <node oor:name="UserDefinedImages">
        <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/RemoveDiacritics_16.svg</value></prop>
        <prop oor:name="ImageBigURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.1xvnoffice.tools/icons/RemoveDiacritics_26.svg</value></prop>
      </node>
    </node>
    </node>
  </node>
</oor:component-data>
