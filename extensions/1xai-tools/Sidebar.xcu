<?xml version="1.0" encoding="UTF-8"?>
<!-- Thanh bên "AI" của 1xAIoffice: một mục trên dải thẻ thanh bên phải, chỉ mở khi người dùng cần. Panel do
     org.1xaioffice.tools.PanelFactory (onex_tools.py) dựng từ dialogs/AiPanel.xdl. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="OnexAiDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">AI</value><value xml:lang="vi">AI</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>OnexAiDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>private:graphicrepository/res/1x_deck_ai.png</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">
            WriterVariants, any, visible;
            Calc, any, visible;
          </value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>150</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="OnexAiPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">AI assistant</value><value xml:lang="vi">Trợ lý AI</value></prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>OnexAiPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>OnexAiDeck</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">
            WriterVariants, any, visible;
            Calc, any, visible;
          </value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/OnexPanelFactory/AiPanel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
        <prop oor:name="WantsAWT" oor:type="xs:boolean"><value>true</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
