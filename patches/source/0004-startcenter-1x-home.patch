+/// Nhãn của một lệnh trong bảng mô tả lệnh của Start Center (rỗng khi extension 1xai-tools vắng mặt).
+OUString lcl_OnexLabel(const OUString& rCommand)
+{
+    return vcl::CommandInfoProvider::GetLabelForCommand(
+        vcl::CommandInfoProvider::GetCommandProperties(rCommand, u"com.sun.star.frame.StartModule"_ustr));
+}
+
+/// "/Users/ten/Documents" -> "~/Documents", cho cột Vị trí gọn như WPS.
+OUString lcl_OnexShortPath(const OUString& rDirPath)
+{
+    // Đường thư mục có thể kết thúc bằng "/": bỏ đi để lấy đúng tên thư mục cuối.
+    const OUString rPath = rDirPath.endsWith("/") && rDirPath.getLength() > 1
+                               ? rDirPath.copy(0, rDirPath.getLength() - 1) : rDirPath;
+    OUString aHome;
+    if (osl::Security().getHomeDir(aHome))
+    {
+        OUString aHomePath;
+        if (osl::FileBase::getSystemPathFromFileURL(aHome, aHomePath) == osl::FileBase::E_None
+            && rPath.startsWith(aHomePath))
+        {
+            const OUString aShort = "~" + rPath.copy(aHomePath.getLength());
+            if (aShort.getLength() <= 32)
+                return aShort;
+        }
+    }
+    // Đường dài thì chỉ giữ thư mục cuối, như WPS hiện "Downloads": không để chữ bị cắt giữa chừng.
+    if (rPath.getLength() > 32)
+        return u"\u2026/"_ustr + rPath.copy(rPath.lastIndexOf('/') + 1);
+    return rPath;
+}
 
+OUString lcl_OnexSize(sal_uInt64 nBytes)
+{
+    if (nBytes < 1024)
+        return OUString::number(nBytes) + " B";
+    if (nBytes < 1024 * 1024)
+        return OUString::number((nBytes + 512) / 1024) + " KB";
+    return OUString::number(static_cast<double>(nBytes / 1024 / 102) / 10.0) + " MB";
+}
+}
