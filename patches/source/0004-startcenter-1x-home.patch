+IMPL_LINK(BackingWindow, OnexLangHdl, weld::Toggleable&, rButton, void)
+{
+    // Giữ hai nút như một công tắc: nút vừa bấm luôn sáng, nút kia tắt; chỉ đổi khi chọn ngôn ngữ khác hiện tại.
+    const bool bWantVi = &rButton == mxOnexLangVi.get();
+    mxOnexLangVi->set_active(bWantVi);
+    mxOnexLangEn->set_active(!bWantVi);
+    const bool bIsVi = Application::GetSettings().GetUILanguageTag().getLanguage() == "vi";
+    if (bWantVi == bIsVi)
+        return;
+    Reference< XDispatchProvider > xFrame( mxFrame, UNO_QUERY );
+    dispatchURL(bWantVi ? u"vnd.1x.tools:UiVietnamese"_ustr : u"vnd.1x.tools:UiEnglish"_ustr, OUString(), xFrame, {});
+}
