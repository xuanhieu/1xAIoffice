+    mxOnexList->clear();
+    int nLastGroup = -1;
+    for (const SvtHistoryOptions::HistoryItem& rItem : SvtHistoryOptions::GetList(EHistoryType::PickList))
+    {
+        INetURLObject aURL(rItem.sURL);
+        const OUString aExt = aURL.getExtension();
+        if (nFilter > 0 && nFilter <= 6
+            && !sfx2::RecentDocsView::typeMatchesExtension(aTypes[nFilter - 1], aExt))
+            continue;
+        OUString aIcon(u"res/odt_16_8.png"_ustr);
+        for (size_t n = 0; n < std::size(aTypes); ++n)
+            if (sfx2::RecentDocsView::typeMatchesExtension(aTypes[n], aExt))
+            {
+                aIcon = OUString::createFromAscii(aIcons[n]);
+                break;
+            }
+        OUString aWhere, aWhen, aSize;
+        int nGroup = 3;
+        if (aURL.GetProtocol() == INetProtocol::File)
+        {
+            INetURLObject aDir(aURL);
+            aDir.removeSegment();
+            aWhere = lcl_OnexShortPath(aDir.getFSysPath(FSysStyle::Detect));
+            osl::DirectoryItem aItem;
+            osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime | osl_FileStatus_Mask_FileSize);
+            if (osl::DirectoryItem::get(rItem.sURL, aItem) == osl::FileBase::E_None
+                && aItem.getFileStatus(aStatus) == osl::FileBase::E_None)
+            {
+                TimeValue aUtc = aStatus.getModifyTime(), aLocal;
+                oslDateTime aDT;
+                if (osl_getLocalTimeFromSystemTime(&aUtc, &aLocal) && osl_getDateTimeFromTimeValue(&aLocal, &aDT))
+                {
+                    const Date aDate(aDT.Day, aDT.Month, aDT.Year);
+                    const tools::Time aTime(aDT.Hours, aDT.Minutes);
+                    const sal_Int32 nDays = aToday - aDate;
+                    nGroup = nDays <= 0 ? 0 : nDays == 1 ? 1 : nDays < 7 ? 2 : 3;
+                    aWhen = nGroup <= 1 ? rLocale.getTime(aTime, false) : rLocale.getDate(aDate);
+                }
+                aSize = lcl_OnexSize(aStatus.getFileSize());
+            }
+        }
+        else
+            aWhere = aURL.GetHost();
+        if (nGroup != nLastGroup)
+        {
+            // Dòng nhóm như WPS: Hôm nay / Hôm qua / Trong 7 ngày / Cũ hơn (không mở được, chữ đậm)
+            mxOnexList->append(OUString(), lcl_OnexLabel(aGroups[nGroup]));
+            mxOnexList->set_text_emphasis(mxOnexList->n_children() - 1, true, 0);
+            nLastGroup = nGroup;
+        }
+        const OUString aTitle = rItem.sTitle.isEmpty() ? aURL.getName(INetURLObject::LAST_SEGMENT, true,
+                                                                       INetURLObject::DecodeMechanism::WithCharset)
+                                                       : rItem.sTitle;
+        mxOnexList->append(rItem.sURL, aTitle, aIcon);
+        const int nRow = mxOnexList->n_children() - 1;
+        mxOnexList->set_text(nRow, aWhere, 1);
+        mxOnexList->set_text(nRow, aWhen, 2);
+        mxOnexList->set_text(nRow, aSize, 3);
+    }
+    mxOnexList->thaw();
+}
+
+IMPL_LINK(BackingWindow, OnexListActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    const OUString aURL = mxOnexList->get_id(rIter);
+    if (!aURL.isEmpty()) // dòng nhóm không có địa chỉ
+        dispatchURL(aURL, u"_default"_ustr, Reference<XDispatchProvider>(),
+                    { comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr),
+                      comphelper::makePropertyValue(u"AsTemplate"_ustr, false) });
+    return true;
+}
