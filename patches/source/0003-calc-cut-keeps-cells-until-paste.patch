+// 1xVnOffice: vùng đã cắt nhưng chưa dán.
+// Lệnh Cut của bản gốc xoá ô ngay lập tức. Excel, WPS và Google Sheets thì giữ nguyên nội dung, vẽ viền đứt, và
+// chỉ chuyển khi người dùng dán — ai quen ba phần mềm kia mà cắt xong đổi ý sẽ tưởng mình vừa mất dữ liệu.
+void ScModule::SetPendingCut( ScDocShell* pShell, const ScRange& rRange )
+{
+    ClearPendingCut();
+    m_pPendingCutShell = pShell;
+    m_aPendingCutRange = rRange;
+    m_nCutMarkPhase = 0;
+    if (pShell)
+    {
+        pShell->PostPaint( rRange, PaintPartFlags::Grid );
+        m_aCutMarkTimer.Start();                         // bắt đầu cho viền chạy
+    }
+}
+
+void ScModule::ClearPendingCut()
+{
+    if (!m_pPendingCutShell)
+        return;
+    m_aCutMarkTimer.Stop();
+    ScDocShell* pShell = m_pPendingCutShell;
+    ScRange aRange = m_aPendingCutRange;
+    m_pPendingCutShell = nullptr;
+    pShell->PostPaint( aRange, PaintPartFlags::Grid );   // xoá viền đứt khỏi màn hình
+}
+
+// Mỗi nhịp dịch nét đứt vài điểm ảnh quanh chu vi rồi xin vẽ lại ĐÚNG dải viền.
+// Vẽ lại cả vùng thì một vùng to sẽ chớp liên tục và tốn máy, nên chỉ vẽ lại hàng trên, hàng dưới, cột trái
+// và cột phải — bốn dải mỏng, bất kể vùng rộng bao nhiêu.
+IMPL_LINK_NOARG(ScModule, CutMarkHandler, Timer *, void)
+{
+    if (!m_pPendingCutShell)
+    {
+        m_aCutMarkTimer.Stop();
+        return;
+    }
+    m_nCutMarkPhase = (m_nCutMarkPhase + SC_CUTMARK_STEP) % SC_CUTMARK_PERIOD;
+    const ScRange& r = m_aPendingCutRange;
+    const SCTAB nTab1 = r.aStart.Tab(), nTab2 = r.aEnd.Tab();
+    const SCCOL nCol1 = r.aStart.Col(), nCol2 = r.aEnd.Col();
+    const SCROW nRow1 = r.aStart.Row(), nRow2 = r.aEnd.Row();
+    m_pPendingCutShell->PostPaint( ScRange( nCol1, nRow1, nTab1, nCol2, nRow1, nTab2 ), PaintPartFlags::Grid );
+    m_pPendingCutShell->PostPaint( ScRange( nCol1, nRow2, nTab1, nCol2, nRow2, nTab2 ), PaintPartFlags::Grid );
+    m_pPendingCutShell->PostPaint( ScRange( nCol1, nRow1, nTab1, nCol1, nRow2, nTab2 ), PaintPartFlags::Grid );
+    m_pPendingCutShell->PostPaint( ScRange( nCol2, nRow1, nTab1, nCol2, nRow2, nTab2 ), PaintPartFlags::Grid );
+    m_aCutMarkTimer.Start();
 }
 
