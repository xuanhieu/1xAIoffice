+// 1xVnOffice: vẽ viền nét đứt chạy quanh một hình chữ nhật.
+// VCL không có tham số "pha" cho nét đứt, nên tự đi vòng chu vi và vẽ từng đoạn nét một. Đi theo chu vi (chứ
+// không vẽ từng cạnh riêng) thì nét chạy liền mạch qua góc, giống Excel. Vẽ theo ĐOẠN chứ không theo điểm ảnh,
+// nên một vùng rộng cũng chỉ tốn chu-vi/8 lệnh vẽ.
+static void lcl_DrawMarchingAnts( OutputDevice& rDev, const tools::Rectangle& rRect, tools::Long nPhase )
+{
+    const Point aCorner[5] = { rRect.TopLeft(), rRect.TopRight(), rRect.BottomRight(),
+                               rRect.BottomLeft(), rRect.TopLeft() };
+    tools::Long nWalked = 0;
+    for ( int nEdge = 0; nEdge < 4; ++nEdge )
+    {
+        const Point& rFrom = aCorner[nEdge];
+        const Point& rTo = aCorner[nEdge + 1];
+        const bool bHoriz = ( rFrom.Y() == rTo.Y() );
+        const tools::Long nLen = bHoriz ? std::abs( rTo.X() - rFrom.X() ) : std::abs( rTo.Y() - rFrom.Y() );
+        const tools::Long nDir = bHoriz ? ( rTo.X() > rFrom.X() ? 1 : -1 ) : ( rTo.Y() > rFrom.Y() ? 1 : -1 );
+        tools::Long nPos = 0;
+        while ( nPos < nLen )
+        {
+            const tools::Long nOff = ( nWalked + nPos + nPhase ) % SC_CUTMARK_PERIOD;
+            if ( nOff >= SC_CUTMARK_DASH )          // đang ở quãng hở
+            {
+                nPos += SC_CUTMARK_PERIOD - nOff;
+                continue;
+            }
+            const tools::Long nRun = std::min( SC_CUTMARK_DASH - nOff, nLen - nPos );
+            const Point aFrom = bHoriz ? Point( rFrom.X() + nDir * nPos, rFrom.Y() )
+                                       : Point( rFrom.X(), rFrom.Y() + nDir * nPos );
+            const Point aTo = bHoriz ? Point( rFrom.X() + nDir * ( nPos + nRun - 1 ), rFrom.Y() )
+                                     : Point( rFrom.X(), rFrom.Y() + nDir * ( nPos + nRun - 1 ) );
+            rDev.DrawLine( aFrom, aTo );
+            nPos += nRun;
+        }
+        nWalked += nLen;
+    }
+}
