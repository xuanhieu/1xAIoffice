Subject: About dialog: 1xAIoffice owners, description and links
Why: The About dialog named the upstream project in its description, copyright and "derived from" lines and linked the build
  id to the upstream repository. 1xAIoffice presents its own owners (xuanhieu.org, 1xag.com) and mission instead. Only
  texts and one link change; ids and layout are unchanged. The license dialog (sfx2) keeps the legally required notices.
  Vietnamese texts: l10n/vi/cui/messages.po.
Upstream: not suitable: product branding.
Test: scripts/build-macos.sh smoke opens the About dialog; docs/ui screenshot about-2026-11-13.png.

--- a/cui/inc/strings.hrc
+++ b/cui/inc/strings.hrc
@@ -357,8 +357,8 @@
 
 #define RID_CUISTR_CANNOTCONVERTURL_ERR             NC_("RID_SVXSTR_CANNOTCONVERTURL_ERR", "The URL <%1> cannot be converted to a filesystem path.")
 
-#define RID_CUISTR_ABOUT_COPYRIGHT                  NC_("aboutdialog|copyright", "Copyright © 2000–2026 LibreOffice contributors.")
-#define RID_CUISTR_ABOUT_VENDOR                     NC_("aboutdialog|vendor", "This release was supplied by %OOOVENDOR.")
+#define RID_CUISTR_ABOUT_COPYRIGHT                  NC_("aboutdialog|copyright", "© 2026 xuanhieu.org · 1xag.com")
+#define RID_CUISTR_ABOUT_VENDOR                     NC_("aboutdialog|vendor", "Made in Vietnam by xuanhieu.org and 1xag.com.")
 #define RID_CUISTR_ABOUT_BASED_ON                   NC_("aboutdialog|libreoffice", "LibreOffice was based on OpenOffice.org.")
 #define RID_CUISTR_ABOUT_DERIVED                    NC_("aboutdialog|derived", "%PRODUCTNAME is derived from LibreOffice which was based on OpenOffice.org")
 #define RID_CUISTR_ABOUT_UILOCALE                   NC_("aboutdialog|uilocale", "UI: $LOCALE")
--- a/cui/source/dialogs/about.cxx
+++ b/cui/source/dialogs/about.cxx
@@ -79,7 +79,7 @@
     if (IsStringValidGitHash(sbuildId))
     {
         const tools::Long nMaxChar = 25;
-        m_pBuildLabel->set_uri("https://git.libreoffice.org/core/commit/" + sbuildId);
+        // 1xAIoffice: the build id is not a link to an upstream repository, just text.
         m_pBuildLabel->set_label(
             sbuildId.getLength() > nMaxChar
                 ? sbuildId.replaceAt(nMaxChar, sbuildId.getLength() - nMaxChar, u"...")
@@ -248,14 +248,8 @@
 OUString AboutDialog::GetCopyrightString()
 {
     OUString sVendorTextStr(CuiResId(RID_CUISTR_ABOUT_VENDOR));
-    OUString aCopyrightString = sVendorTextStr + "\n" + CuiResId(RID_CUISTR_ABOUT_COPYRIGHT) + "\n";
-
-    if (utl::ConfigManager::getProductName() == "LibreOffice")
-        aCopyrightString += CuiResId(RID_CUISTR_ABOUT_BASED_ON);
-    else
-        aCopyrightString += CuiResId(RID_CUISTR_ABOUT_DERIVED);
-
-    return aCopyrightString;
+    // 1xAIoffice: vendor and copyright lines only.
+    return sVendorTextStr + "\n" + CuiResId(RID_CUISTR_ABOUT_COPYRIGHT);
 }
 
 // special labels to comply with previous version info
