+                <property name="label" translatable="yes" context="aboutdialog|description">%PRODUCTNAME is a free, private, all-in-one office suite for Vietnam: documents, spreadsheets and presentations in one app (1xDoc, 1xSheet, 1xSlide), with Vietnamese tools built in.</property>
                 <property name="wrap">True</property>
