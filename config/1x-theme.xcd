<?xml version="1.0" encoding="UTF-8"?>
<!-- 1xAIoffice theme layer (MPL-2.0). GENERATED by scripts/brand/make-brand.py from branding/tokens.json; edit the
     tokens, not this file. Installed into the app's registry folder by scripts/build-macos.sh (step "config").
     Direction "Sơn mài": blue-tinted graphite surfaces, one cobalt accent; gold is reserved for the logo.
     Users can still switch to Automatic/Light/Dark in Tools > Options > Appearance. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="UI">
    <node oor:name="ColorScheme">
      <prop oor:name="CurrentColorScheme" oor:op="fuse"><value>1xAIoffice</value></prop>
      <node oor:name="ColorSchemes">
        <node oor:name="1xAIoffice" oor:op="replace">
          <node oor:name="AppBackground"><prop oor:name="Color"><value>1184535</value></prop></node>  <!-- #121317 -->
          <node oor:name="WindowColor"><prop oor:name="Color"><value>1842466</value></prop></node>  <!-- #1C1D22 -->
          <node oor:name="WindowTextColor"><prop oor:name="Color"><value>15264238</value></prop></node>  <!-- #E8E9EE -->
          <node oor:name="BaseColor"><prop oor:name="Color"><value>2368811</value></prop></node>  <!-- #24252B -->
          <node oor:name="ButtonColor"><prop oor:name="Color"><value>2895413</value></prop></node>  <!-- #2C2E35 -->
          <node oor:name="ButtonTextColor"><prop oor:name="Color"><value>15527410</value></prop></node>  <!-- #ECEDF2 -->
          <node oor:name="AccentColor"><prop oor:name="Color"><value>5012991</value></prop></node>  <!-- #4C7DFF -->
          <node oor:name="DisabledColor"><prop oor:name="Color"><value>3816516</value></prop></node>  <!-- #3A3C44 -->
          <node oor:name="DisabledTextColor"><prop oor:name="Color"><value>8159114</value></prop></node>  <!-- #7C7F8A -->
          <node oor:name="ShadowColor"><prop oor:name="Color"><value>855569</value></prop></node>  <!-- #0D0E11 -->
          <node oor:name="SeparatorColor"><prop oor:name="Color"><value>3355965</value></prop></node>  <!-- #33353D -->
          <node oor:name="FaceColor"><prop oor:name="Color"><value>1842466</value></prop></node>  <!-- #1C1D22 -->
          <node oor:name="ActiveColor"><prop oor:name="Color"><value>2434862</value></prop></node>  <!-- #25272E -->
          <node oor:name="ActiveTextColor"><prop oor:name="Color"><value>15922167</value></prop></node>  <!-- #F2F3F7 -->
          <node oor:name="ActiveBorderColor"><prop oor:name="Color"><value>3816775</value></prop></node>  <!-- #3A3D47 -->
          <node oor:name="FieldColor"><prop oor:name="Color"><value>2303018</value></prop></node>  <!-- #23242A -->
          <node oor:name="MenuBarColor"><prop oor:name="Color"><value>1513500</value></prop></node>  <!-- #17181C -->
          <node oor:name="MenuBarTextColor"><prop oor:name="Color"><value>14277602</value></prop></node>  <!-- #D9DBE2 -->
          <node oor:name="MenuBarHighlightColor"><prop oor:name="Color"><value>3029598</value></prop></node>  <!-- #2E3A5E -->
          <node oor:name="MenuBarHighlightTextColor"><prop oor:name="Color"><value>16777215</value></prop></node>  <!-- #FFFFFF -->
          <node oor:name="MenuColor"><prop oor:name="Color"><value>2105639</value></prop></node>  <!-- #202127 -->
          <node oor:name="MenuTextColor"><prop oor:name="Color"><value>15132652</value></prop></node>  <!-- #E6E7EC -->
          <node oor:name="MenuHighlightColor"><prop oor:name="Color"><value>5012991</value></prop></node>  <!-- #4C7DFF -->
          <node oor:name="MenuHighlightTextColor"><prop oor:name="Color"><value>16777215</value></prop></node>  <!-- #FFFFFF -->
          <node oor:name="MenuBorderColor"><prop oor:name="Color"><value>3355965</value></prop></node>  <!-- #33353D -->
          <node oor:name="InactiveColor"><prop oor:name="Color"><value>1710880</value></prop></node>  <!-- #1A1B20 -->
          <node oor:name="InactiveTextColor"><prop oor:name="Color"><value>10132904</value></prop></node>  <!-- #9A9DA8 -->
          <node oor:name="InactiveBorderColor"><prop oor:name="Color"><value>2763827</value></prop></node>  <!-- #2A2C33 -->
        </node>
      </node>
    </node>
  </oor:component-data>
  <!-- Theme on (1 = Enabled), dark application colors (2) so unset document-area colors use their dark variants;
       pages stay white (UseOnlyWhiteDocBackground). -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Appearance">
      <prop oor:name="LibreOfficeTheme" oor:op="fuse"><value>1</value></prop>
      <prop oor:name="ApplicationAppearance" oor:op="fuse"><value>2</value></prop>
      <prop oor:name="UseOnlyWhiteDocBackground" oor:op="fuse"><value>true</value></prop>
    </node>
    <!-- Icon theme "1x" (images_1x.zip): only the replaced icons, the rest falls back to colibre_dark. -->
    <node oor:name="Misc">
      <prop oor:name="SymbolStyle" oor:op="fuse"><value>1x</value></prop>
      <prop oor:name="ShowDonation" oor:op="fuse"><value>false</value></prop>
      <!-- Ribbon background: 235/255 theme color, only a hint of the app's own color. -->
      <prop oor:name="NotebookbarColorTransparency" oor:op="fuse"><value>235</value></prop>
    </node>
    <!-- Recent documents area of the Start Center uses its own colors. -->
    <node oor:name="Help">
      <node oor:name="StartCenter">
        <prop oor:name="StartCenterThumbnailsBackgroundColor" oor:op="fuse"><value>1513500</value></prop>
        <prop oor:name="StartCenterThumbnailsTextColor" oor:op="fuse"><value>15264238</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
