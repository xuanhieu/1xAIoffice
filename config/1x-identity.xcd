<?xml version="1.0" encoding="UTF-8"?>
<!-- 1xVnOffice identity layer (MPL-2.0): every web address behind Help, About, the Start Center and the Extension
     Manager points at the 1xVnOffice owners instead of the upstream project. Installed into the app's registry folder by
     scripts/build-macos.sh (step "config"). Only site roots and the public repository are used, so no link depends on a
     page that may not exist yet; deeper pages can replace them as they go live. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Menus">
      <prop oor:name="SendFeedbackURL" oor:op="fuse"><value>https://github.com/xuanhieu/1xvnoffice/issues</value></prop>
      <prop oor:name="QA_URL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="DocumentationURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="GetInvolvedURL" oor:op="fuse"><value>https://github.com/xuanhieu/1xvnoffice</value></prop>
      <prop oor:name="DonationURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="ReleaseNotesURL" oor:op="fuse"><value>https://github.com/xuanhieu/1xvnoffice/releases</value></prop>
      <prop oor:name="CreditsURL" oor:op="fuse"><value>https://xuanhieu.org</value></prop>
      <prop oor:name="HyphenationMissingURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="InstallJavaURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="VolunteerURL" oor:op="fuse"><value>https://github.com/xuanhieu/1xvnoffice</value></prop>
      <prop oor:name="PrivacyPolicyURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      <prop oor:name="ExtensionsURL" oor:op="fuse"><value>https://1xag.com</value></prop>
    </node>
    <node oor:name="Help">
      <node oor:name="StartCenter">
        <prop oor:name="InfoURL" oor:op="fuse"><value>https://1xag.com</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="ExtensionManager">
    <node oor:name="ExtensionRepositories">
      <prop oor:name="WebsiteLink" oor:op="fuse"><value>https://1xag.com</value></prop>
    </node>
  </oor:component-data>
</oor:data>
