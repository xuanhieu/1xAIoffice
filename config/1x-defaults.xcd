<?xml version="1.0" encoding="UTF-8"?>
<!-- 1xVnOffice default configuration layer (MPL-2.0). Installed into the app's registry folder by
     scripts/build-macos.sh (step "config"); user choices made in Options still override every value here.
     Each block says why it exists. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <!-- Load after the module layers: writer/calc/impress.xcd set their own default save filters and would win. -->
  <dependency file="main"/>
  <dependency file="writer"/>
  <dependency file="calc"/>
  <dependency file="impress"/>

  <!-- Ribbon (tabbed notebookbar) instead of LibreOffice's classic menus and toolbars, in every module.
       The ribbon content itself is redesigned in phase 2 (docs/UI_DESIGN.md).
       "Active" holds the mode's CommandArg (notebookbar.ui = Tabbed), not the mode name. -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
    <node oor:name="Applications">
      <node oor:name="Writer"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Calc"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Impress"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Draw"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
    </node>
  </oor:component-data>

  <!-- English user interface by default (owner's decision 2026-11-13); Vietnamese is fully translated and chosen in
       Tools > Options > Language Settings > Languages. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Linguistic">
    <node oor:name="General">
      <prop oor:name="UILocale" oor:op="fuse"><value>en-US</value></prop>
    </node>
  </oor:component-data>

  <!-- Personal and business profiles save in Microsoft Office formats without the "keep format?" prompt.
       The government profile overrides these with ODF 1.2 (docs/legal/STATUS.md, Circulars 19/2011 and 39/2017). -->
  <oor:component-data oor:package="org.openoffice" oor:name="Setup">
    <!-- No LibreOffice welcome / what's-new dialog, and no TDF "Get involved" / "Donate" infobars: the timestamps
         are set far in the future and finalized, so the 90-day reminders never come due. -->
    <node oor:name="Product">
      <prop oor:name="WhatsNew" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse" oor:finalized="true"><value>32503680000</value></prop>
      <prop oor:name="LastTimeDonateShown" oor:op="fuse" oor:finalized="true"><value>32503680000</value></prop>
    </node>
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>MS Word 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Calc MS Excel 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Impress MS PowerPoint 2007 XML</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <!-- No "Tip of the day" dialog at every start. -->
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
    </node>
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
  <!-- 1xSlide opens on an empty slide like PowerPoint and WPS, without LibreOffice's "Select a Template" dialog. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Impress">
    <node oor:name="Misc">
      <node oor:name="NewDoc">
        <prop oor:name="AutoPilot" oor:op="fuse"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
