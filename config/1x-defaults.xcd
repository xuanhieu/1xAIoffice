<?xml version="1.0" encoding="UTF-8"?>
<!-- 1xAIoffice default configuration layer (MPL-2.0). Installed into the app's registry folder by
     scripts/build-macos.sh (step "config"); user choices made in Options still override every value here.
     Each block says why it exists. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <!-- Load after the module layers: writer/calc/impress.xcd set their own default save filters and would win. -->
  <dependency file="main"/>
  <dependency file="writer"/>
  <dependency file="calc"/>
  <dependency file="impress"/>

  <!-- Ribbon (tabbed notebookbar) instead of upstream's classic menus and toolbars, in every module.
       The ribbon content itself is redesigned in phase 2 (docs/UI_DESIGN.md).
       "Active" holds the mode's CommandArg (notebookbar.ui = Tabbed), not the mode name. -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
    <node oor:name="Applications">
      <node oor:name="Writer"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Calc"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Impress"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
      <node oor:name="Draw"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
    </node>
  </oor:component-data>

  <!-- English user interface by default (owner's decision 2026-11-13); Vietnamese is fully translated and chosen in
       Tools > Options > Language Settings > Languages.
       The DOCUMENT language is Vietnamese: spell checking, sorting, number and date formats all follow it, and the
       status bar of an untouched document said "English (USA)" before this. A Vietnamese office suite that opens a
       new document in English is wrong whatever language its menus are in. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Linguistic">
    <node oor:name="General">
      <prop oor:name="UILocale" oor:op="fuse"><value>en-US</value></prop>
      <prop oor:name="DefaultLocale" oor:op="fuse"><value>vi-VN</value></prop>
    </node>
  </oor:component-data>

  <!-- Default fonts for Vietnamese documents.
       Nghị định 30/2020/NĐ-CP, Phụ lục I asks for Times New Roman at 13-14pt for administrative documents, and that
       is what Vietnamese offices use for everything else too. Upstream has no "vi" entry here, so both 1xDoc and
       1xSheet fell back to the English list and opened with Liberation Sans - a name that also tells everyone which
       suite this was built from.
       Times New Roman comes first because macOS and Windows both ship it; Liberation Serif right after it is
       metric-compatible, so Linux lays out the same page. Fixed-width and presentation fonts stay as upstream:
       Nghị định 30 says nothing about slides, and Times New Roman on a slide looks dated. -->
  <oor:component-data oor:package="org.openoffice" oor:name="VCL">
    <node oor:name="DefaultFonts">
      <node oor:name="vi" oor:op="replace">
        <prop oor:name="LATIN_TEXT" oor:type="xs:string" oor:op="replace">
          <value>Times New Roman;Liberation Serif;Thorndale AMT;Thorndale;Tinos;Nimbus Roman No9 L;DejaVu Serif;Times;Serif</value>
        </prop>
        <prop oor:name="LATIN_SPREADSHEET" oor:type="xs:string" oor:op="replace">
          <value>Times New Roman;Liberation Serif;Thorndale AMT;Thorndale;Tinos;Nimbus Roman No9 L;DejaVu Serif;Times;Serif</value>
        </prop>
        <prop oor:name="LATIN_HEADING" oor:type="xs:string" oor:op="replace">
          <value>Times New Roman;Liberation Serif;Thorndale AMT;Thorndale;Tinos;Nimbus Roman No9 L;DejaVu Serif;Times;Serif</value>
        </prop>
      </node>
    </node>
  </oor:component-data>

  <!-- 13pt body text: the lower of the two sizes Nghị định 30 allows, and the one Vietnamese offices use most.
       The unit is 1/100 mm (sw/source/uibase/config/fontcfg.cxx converts it with o3tl::Length::mm100), so
       13pt = 13 x 25.4 / 72 mm = 4.586 mm = 459. An earlier value of 260 read as 7.3pt. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Writer">
    <node oor:name="DefaultFont">
      <prop oor:name="StandardHeight" oor:op="fuse"><value>459</value></prop>
    </node>
  </oor:component-data>

  <!-- Personal and business profiles save in Microsoft Office formats without the "keep format?" prompt.
       The government profile overrides these with ODF 1.2 (docs/legal/STATUS.md, Circulars 19/2011 and 39/2017). -->
  <oor:component-data oor:package="org.openoffice" oor:name="Setup">
    <!-- No upstream welcome / what's-new dialog, and no TDF "Get involved" / "Donate" infobars: the timestamps
         are set far in the future and finalized, so the 90-day reminders never come due. -->
    <node oor:name="Product">
      <prop oor:name="WhatsNew" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse" oor:finalized="true"><value>32503680000</value></prop>
      <prop oor:name="LastTimeDonateShown" oor:op="fuse" oor:finalized="true"><value>32503680000</value></prop>
    </node>
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>MS Word 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Calc MS Excel 2007 XML</value></prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Impress MS PowerPoint 2007 XML</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <!-- No "Tip of the day" dialog at every start. -->
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
    </node>
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
  <!-- 1xSlide opens on an empty slide like PowerPoint and WPS, without upstream's "Select a Template" dialog. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Impress">
    <node oor:name="Misc">
      <node oor:name="NewDoc">
        <prop oor:name="AutoPilot" oor:op="fuse"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
  <!-- 1xSlide hides upstream's docked Drawing toolbar: shapes, lines and text boxes are on the ribbon's Insert tab,
       like PowerPoint and WPS. -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ImpressWindowState">
    <node oor:name="UIElements">
      <node oor:name="States">
        <node oor:name="private:resource/toolbar/toolbar" oor:op="fuse">
          <prop oor:name="Visible" oor:op="fuse"><value>false</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- Tự lưu để không mất việc khi app hay máy gặp sự cố (chủ dự án yêu cầu 15/11/2026). Ba lớp:
       1. Thông tin khôi phục mỗi 2 phút (mặc định của bản gốc là 10).
       2. Lưu thẳng tài liệu đã có tên tệp cùng nhịp đó (UserAutoSaveEnabled; bản gốc tắt).
       3. Giữ một bản sao lưu mỗi lần lưu (CreateBackup).
       Người dùng tắt hoặc đổi nhịp trong Công cụ > Tuỳ chọn > Tải/Lưu > Chung. 2 phút chứ không 1, để bảng tính lớn
       không bị khựng mỗi phút. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Recovery">
    <node oor:name="AutoSave">
      <prop oor:name="Enabled" oor:op="fuse"><value>true</value></prop>
      <prop oor:name="UserAutoSaveEnabled" oor:op="fuse"><value>true</value></prop>
      <prop oor:name="TimeIntervall" oor:op="fuse"><value>2</value></prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="CreateBackup" oor:op="fuse"><value>true</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
