msgstr "Chiều _ngang"

#: sw/messages.po
msgctxt "frmtypepage|horibyft"
msgid "b_y"
msgstr "the_o"

#: sw/messages.po
msgctxt "frmtypepage|horitoft"
msgid "_to"
msgstr "_đến"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|byhori"
msgid "Enter the amount of space to leave between the left edge of the selected object and the reference point that you select in the To box."
msgstr "Nhập khoảng cách muốn chừa giữa cạnh trái của đối tượng đã chọn và điểm tham chiếu bạn chọn trong hộp Đến."

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|horianchor"
msgid "Select the reference point for the selected horizontal alignment option."
msgstr "Chọn điểm tham chiếu cho tùy chọn căn lề ngang đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|horipos"
msgid "Select the horizontal alignment option for the object."
msgstr "Chọn tùy chọn căn lề ngang cho đối tượng."

#: sw/messages.po
msgctxt "frmtypepage|vertposft"
msgid "_Vertical"
msgstr "_Dọc"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|vertpos"
msgid "Select the vertical alignment option for the object."
msgstr "Chọn tùy chọn căn lề dọc cho đối tượng."

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|byvert"
msgid "Enter the amount of space to leave between the top edge of the selected object and the reference point that you select in the To box."
msgstr "Nhập khoảng cách muốn chừa giữa cạnh trên của đối tượng đã chọn và điểm tham chiếu bạn chọn trong hộp Đến."

#: sw/messages.po
msgctxt "frmtypepage|verttoft"
msgid "t_o"
msgstr "đ_ến"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|vertanchor"
msgid "Select the reference point for the selected vertical alignment option."
msgstr "Chọn điểm tham chiếu cho tùy chọn căn lề dọc đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|mirror"
msgid "_Mirror on even pages"
msgstr "_Đối xứng ở trang chẵn"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|mirror"
msgid "Reverses the current horizontal alignment settings on even pages."
msgstr "Đảo ngược các thiết lập căn lề ngang hiện tại ở các trang chẵn."

#: sw/messages.po
msgctxt "frmtypepage|followtextflow"
msgid "Keep inside text boundaries"
msgstr "Giữ trong ranh giới văn bản"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|followtextflow"
msgid "Keeps the selected object within the layout boundaries of the text that the object is anchored to. To place the selected object anywhere in your document, do not select this option."
msgstr "Giữ đối tượng đã chọn trong ranh giới bố cục của văn bản mà đối tượng được neo vào. Để đặt đối tượng ở bất kỳ đâu trong tài liệu, đừng chọn tùy chọn này."

#: sw/messages.po
msgctxt "frmtypepage|flysplit"
msgid "Allow frame to split across pages"
msgstr "Cho phép khung tách qua nhiều trang"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|FrameTypePage"
msgid "Specifies the size and the position of the selected object or frame on a page."
msgstr "Chỉ định kích thước và vị trí của đối tượng hoặc khung đã chọn trên trang."

