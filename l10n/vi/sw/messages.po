msgid "Specify the name of the frame where you want to open the targeted file."
msgstr "Chỉ định tên khung nơi bạn muốn mở tệp đích."

#: sw/messages.po
msgctxt "frmurlpage|label1"
msgid "Link to"
msgstr "Liên kết tới"

#: sw/messages.po
msgctxt "frmurlpage|server"
msgid "_Server-side image map"
msgstr "Bản đồ ảnh phía má_y chủ"

#: sw/messages.po
msgctxt "frmurlpage|client"
msgid "_Client-side image map"
msgstr "Bản đồ ảnh phía má_y khách"

#: sw/messages.po
msgctxt "frmurlpage|label2"
msgid "Image Map"
msgstr "Bản đồ ảnh"

#: sw/messages.po
msgctxt "frmurlpage|extended_tip|FrameURLPage"
msgid "Specify the properties of the hyperlink for the selected graphic, frame or OLE object."
msgstr "Chỉ định thuộc tính của siêu liên kết cho ảnh, khung hoặc đối tượng OLE đã chọn."

#: sw/messages.po
msgctxt "headerfootermenu|borderback"
msgid "Border and Background..."
msgstr "Đường viền và nền..."

#: sw/messages.po
msgctxt "headerfootermenu|insert_pagenumber"
msgid "Insert Page Number"
msgstr "Chèn số trang"

#: sw/messages.po
msgctxt "headerfootermenu|insert_pagecount"
msgid "Insert Page Count"
msgstr "Chèn tổng số trang"

#: sw/messages.po
msgctxt "headerfootermenu|insert_pagecount_in_range"
msgid "Insert Page Count In Page Numbering Range"
msgstr "Chèn tổng số trang trong phạm vi đánh số trang"

#: sw/messages.po
msgctxt "headerfootermenu|insert_pagecount_in_range|tooltip_text"
msgid "Insert number of pages in the range of pages until the page numbering is modified."
msgstr "Chèn số trang trong phạm vi trang cho đến khi việc đánh số trang thay đổi."

#: sw/messages.po
msgctxt "indentpage|label1"
msgid "_Before section"
msgstr "_Trước phần"

#: sw/messages.po
msgctxt "indentpage|label3"
msgid "_After section"
msgstr "_Sau phần"

#: sw/messages.po
msgctxt "indexentry|tooltip_text|close"
msgid "Close dialog without saving non-applied changes."
msgstr "Đóng hộp thoại mà không lưu các thay đổi chưa áp dụng."

#: sw/messages.po
msgctxt "indexentry"
msgid "Reset"
msgstr "Đặt lại"

#: sw/messages.po
msgctxt "indexentry|typeft"
msgid "Index:"
msgstr "Chỉ mục:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|typecb"
msgid "Select the index that you want to add the entry to."
msgstr "Chọn chỉ mục mà bạn muốn thêm mục nhập vào."

#: sw/messages.po
msgctxt "indexentry|label3"
msgid "Entry:"
msgstr "Mục nhập:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|entryed"
msgid "Displays the text that is selected in the document. If you want, you can enter a different word for the index entry. The selected text in the document is not changed."
msgstr "Hiển thị văn bản đang chọn trong tài liệu. Nếu muốn, bạn có thể nhập một từ khác cho mục nhập chỉ mục. Văn bản đã chọn trong tài liệu không bị thay đổi."

#: sw/messages.po
msgctxt "indexentry|sync|tooltip_text"
msgid "Update entry from selection"
msgstr "Cập nhật mục nhập từ vùng chọn"

#: sw/messages.po
msgctxt "indexentry|phonetic0ft"
msgid "Phonetic reading:"
msgstr "Cách đọc phiên âm:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|phonetic0ed"
msgid "Enter the phonetic reading for the corresponding entry. For example, if a Japanese Kanji word has more than one pronunciation, enter the correct pronunciation as a Katakana word. The Kanji word is then sorted according to the phonetic reading entry."
msgstr "Nhập cách đọc phiên âm cho mục nhập tương ứng. Ví dụ, nếu một từ Kanji tiếng Nhật có nhiều cách phát âm, hãy nhập cách phát âm đúng dưới dạng từ Katakana. Từ Kanji sẽ được sắp xếp theo cách đọc phiên âm đã nhập."

#: sw/messages.po
msgctxt "indexentry|phonetic1ft"
msgid "Phonetic reading:"
msgstr "Cách đọc phiên âm:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|phonetic1ed"
msgid "Enter the phonetic reading for the corresponding entry."
msgstr "Nhập cách đọc phiên âm cho mục nhập tương ứng."

#: sw/messages.po
msgctxt "indexentry|phonetic2ft"
msgid "Phonetic reading:"
msgstr "Cách đọc phiên âm:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|phonetic2ed"
msgid "Enter the phonetic reading for the corresponding entry."
msgstr "Nhập cách đọc phiên âm cho mục nhập tương ứng."

#: sw/messages.po
msgctxt "indexentry|key1ft"
msgid "1st key:"
msgstr "Khóa 1:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|key1cb"
msgid "Makes the current selection a subentry of the word that you enter here. For example, if you select “cold”, and enter “weather” as the 1st key, the index entry will be “weather, cold”."
msgstr "Biến vùng chọn hiện tại thành mục con của từ bạn nhập ở đây. Ví dụ, nếu bạn chọn “cold”, rồi nhập “weather” làm Khóa 1, mục nhập chỉ mục sẽ là “weather, cold”."

#: sw/messages.po
msgctxt "indexentry|key2ft"
msgid "2nd key:"
msgstr "Khóa 2:"

#: sw/messages.po
msgctxt "indexentry|extended_tip|key2cb"
msgid "Makes the current selection a sub-subentry of the 1st key. For example, if you select “cold”, and enter “weather” as the 1st key and “winter” as the 2nd key, the index entry will be “weather, winter, cold”."
msgstr "Biến vùng chọn hiện tại thành mục con cấp hai của Khóa 1. Ví dụ, nếu bạn chọn “cold”, rồi nhập “weather” làm Khóa 1 và “winter” làm Khóa 2, mục nhập chỉ mục sẽ là “weather, winter, cold”."

#: sw/messages.po
msgctxt "indexentry|levelft"
msgid "Index level:"
msgstr "Cấp chỉ mục:"

#: sw/messages.po
msgctxt "indexentry|levelnf"
msgid "Enter the index level for the entry, which determines the appearance of the entry in the generated index."
msgstr "Nhập cấp chỉ mục cho mục nhập; cấp này quyết định cách mục nhập hiển thị trong chỉ mục được tạo."

#: sw/messages.po
msgctxt "indexentry|extended_tip|levelnf"
msgid "Enter the index level for the entry. The index level determines the appearance of the entry, according to the settings for that level in the “Entries” tab and the “Styles” tab in the “Table of Contents, Index, or Bibliography” dialog. With default settings, a higher index level results in a greater indent for the entry in the generated index."
msgstr "Nhập cấp chỉ mục cho mục nhập. Cấp chỉ mục quyết định cách mục nhập hiển thị, theo thiết lập của cấp đó ở thẻ “Mục nhập” và thẻ “Kiểu” trong hộp thoại “Mục lục, chỉ mục hoặc tài liệu tham khảo”. Với thiết lập mặc định, cấp chỉ mục càng cao thì mục nhập thụt vào càng nhiều trong chỉ mục được tạo."

#: sw/messages.po
msgctxt "indexentry|extended_tip|mainentrycb"
msgid "Makes the selected text the main entry in an alphabetical index."
msgstr "Đặt văn bản đã chọn làm mục nhập chính trong chỉ mục theo thứ tự bảng chữ cái."

#: sw/messages.po
msgctxt "indexentry|applytoallcb"
msgid "Apply to all other occurrences"
msgstr "Áp dụng cho mọi lần xuất hiện khác"

#: sw/messages.po
msgctxt "indexentry|applytoallcb|tooltip_text"
msgid "Add an index entry to any other occurrences of the text selected into “Entry”."
msgstr "Thêm mục nhập chỉ mục cho mọi lần xuất hiện khác của văn bản đã chọn vào “Mục nhập”."

#: sw/messages.po
msgctxt "indexentry|extended_tip|applytoallcb"
msgid "Add an index entry to any other occurrences of the text selected into “Entry”. For a modified entry, the match is conducted on the original selection, but the modified entry is inserted, and will appear in the index."
msgstr "Thêm mục nhập chỉ mục cho mọi lần xuất hiện khác của văn bản đã chọn vào “Mục nhập”. Với mục nhập đã sửa, việc đối chiếu dựa trên vùng chọn gốc, nhưng mục nhập đã sửa sẽ được chèn và hiển thị trong chỉ mục."

#: sw/messages.po
msgctxt "indexentry|last|tooltip_text"
msgid "Next entry (same name)"
msgstr "Mục nhập kế tiếp (cùng tên)"

#: sw/messages.po
msgctxt "indexentry|extended_tip|last"
msgid "Jumps to the next index entry of the same type and with the same name in the document."
msgstr "Nhảy tới mục nhập chỉ mục kế tiếp cùng loại và cùng tên trong tài liệu."

#: sw/messages.po
msgctxt "indexentry|first|tooltip_text"
msgid "Previous entry (same name)"
msgstr "Mục nhập trước đó (cùng tên)"

#: sw/messages.po
msgctxt "indexentry|extended_tip|first"
msgid "Jumps to the previous index entry of the same type and with the same name in the document."
msgstr "Nhảy tới mục nhập chỉ mục trước đó cùng loại và cùng tên trong tài liệu."

#: sw/messages.po
msgctxt "indexentry|previous|tooltip_text"
msgid "Previous entry"
msgstr "Mục nhập trước đó"

#: sw/messages.po
msgctxt "indexentry|extended_tip|previous"
msgid "Jumps to the previous index entry of the same type in the document."
msgstr "Nhảy tới mục nhập chỉ mục trước đó cùng loại trong tài liệu."

#: sw/messages.po
msgctxt "indexentry|next|tooltip_text"
msgid "Next entry"
msgstr "Mục nhập kế tiếp"

#: sw/messages.po
msgctxt "indexentry|extended_tip|next"
msgid "Jumps to the next index entry of the same type in the document."
msgstr "Nhảy tới mục nhập chỉ mục kế tiếp cùng loại trong tài liệu."

#: sw/messages.po
msgctxt "indexentry|extended_tip|IndexEntryDialog"
msgid "Marks the selected text as index or table of contents entry. Edits the selected index entry."
