msgstr "Chiều _cao (tối thiểu)"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|height"
msgid "Enter the height that you want for the selected object."
msgstr "Nhập chiều cao bạn muốn cho đối tượng đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|relheight"
msgid "Re_lative to"
msgstr "Tương đố_i so với"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|relheightrelation"
msgid "Decides what 100% height means: either text area (excluding margins) or the entire page (including margins)."
msgstr "Quyết định 100% chiều cao nghĩa là gì: vùng văn bản (không gồm lề) hoặc toàn bộ trang (gồm cả lề)."

#: sw/messages.po
msgctxt "frmtypepage|autoheight"
msgid "AutoSize"
msgstr "Tự động đổi cỡ"

#: sw/messages.po
msgctxt "frmtypepage|origsize"
msgid "_Original Size"
msgstr "Kích thước _gốc"

#: sw/messages.po
msgctxt "frmtypepage|ratio_tip"
msgid "Keep ratio"
msgstr "Giữ tỷ lệ"

#: sw/messages.po
msgctxt "frmtypepage|accessible_name|CBX_SCALE"
msgid "Keep Ratio"
msgstr "Giữ tỷ lệ"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|CBX_SCALE"
msgid "Maintains proportions when you resize the selected object."
msgstr "Giữ nguyên tỷ lệ khi bạn đổi kích thước đối tượng đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|label2"
msgid "Size"
msgstr "Kích thước"

#: sw/messages.po
msgctxt "frmtypepage|topage"
msgid "To _page"
msgstr "Vào _trang"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|topage"
msgid "Anchors the selection to the current page."
msgstr "Neo vùng chọn vào trang hiện tại."

#: sw/messages.po
msgctxt "frmtypepage|topara"
msgid "To paragrap_h"
msgstr "Vào đoạn vă_n"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|topara"
msgid "Anchors the selection to the current paragraph."
msgstr "Neo vùng chọn vào đoạn văn hiện tại."

#: sw/messages.po
msgctxt "frmtypepage|tochar"
msgid "To cha_racter"
msgstr "Vào _ký tự"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|tochar"
msgid "Anchors the selection to a character."
msgstr "Neo vùng chọn vào một ký tự."

#: sw/messages.po
msgctxt "frmtypepage|aschar"
msgid "_As character"
msgstr "_Như ký tự"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|aschar"
msgid "Anchors the selection as character. The height of the current line is resized to match the height of the selection."
msgstr "Neo vùng chọn như một ký tự. Chiều cao của dòng hiện tại được đổi để khớp với chiều cao của vùng chọn."

#: sw/messages.po
msgctxt "frmtypepage|toframe"
msgid "To _frame"
msgstr "Vào _khung"

#: sw/messages.po
msgctxt "frmtypepage|lbPreview"
msgid "Preview"
msgstr "Xem trước"

#: sw/messages.po
msgctxt "frmtypepage|protectcontent"
msgid "_Contents"
msgstr "_Nội dung"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|protectcontent"
msgid "Prevents changes to the contents of the selected item."
msgstr "Ngăn thay đổi nội dung của mục đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|protectframe"
msgid "P_osition"
msgstr "_Vị trí"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|protectframe"
msgid "Locks the position of the selected item in the current document."
msgstr "Khóa vị trí của mục đã chọn trong tài liệu hiện tại."

#: sw/messages.po
msgctxt "frmtypepage|protectsize"
msgid "_Size"
msgstr "_Kích thước"

#: sw/messages.po
msgctxt "frmtypepage|extended_tip|protectsize"
msgid "Locks the size of the selected item."
msgstr "Khóa kích thước của mục đã chọn."

#: sw/messages.po
msgctxt "frmtypepage|label8"
msgid "Protect"
msgstr "Bảo vệ"

#: sw/messages.po
