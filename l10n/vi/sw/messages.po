#: sw/messages.po
msgctxt "optgeneralpage|updatefields"
msgid "_Fields"
msgstr "_Trường"

#: sw/messages.po
msgctxt "extended_tip|updatefields"
msgid "The contents of all fields are updated automatically whenever the screen contents are displayed as new. Even with this box unchecked, some fields are updated each time a special condition takes place."
msgstr "Nội dung của mọi trường được cập nhật tự động mỗi khi nội dung màn hình được hiển thị lại. Dù không chọn hộp này, một số trường vẫn được cập nhật mỗi khi có điều kiện đặc biệt xảy ra."

#: sw/messages.po
msgctxt "optgeneralpage|updatecharts"
msgid "_Charts"
msgstr "_Biểu đồ"

#: sw/messages.po
msgctxt "extended_tip|updatecharts"
msgid "Specifies whether to automatically update charts. Whenever a Writer table cell value changes and the cursor leaves that cell, the chart that displays the cell value is updated automatically."
msgstr "Chỉ định có tự động cập nhật biểu đồ hay không. Khi giá trị ô trong bảng Writer thay đổi và con trỏ rời khỏi ô đó, biểu đồ hiển thị giá trị ô sẽ được cập nhật tự động."

#: sw/messages.po
msgctxt "optgeneralpage|label2"
msgid "Automatically Update"
msgstr "Tự động cập nhật"

#: sw/messages.po
msgctxt "optgeneralpage|always"
msgid "_Always"
msgstr "_Luôn luôn"

#: sw/messages.po
msgctxt "extended_tip|always"
msgid "Always updates links while loading a document, and only if the document is in a trusted file location or the global security level is Low (Not recommended)."
msgstr "Luôn cập nhật liên kết khi mở tài liệu, và chỉ khi tài liệu nằm ở vị trí tệp tin cậy hoặc mức bảo mật chung là Thấp (không khuyến nghị)."

#: sw/messages.po
msgctxt "optgeneralpage|onrequest"
msgid "_On request"
