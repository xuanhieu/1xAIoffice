msgstr "Chỉ định tùy chọn lật và liên kết cho ảnh đã chọn."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|pagebackground"
msgid "Specifies whether to print colors and objects that are inserted to the background of the page, which you have specified under Format - Page - Background."
msgstr "Chỉ định có in màu và đối tượng được chèn vào nền trang (đã đặt trong Định dạng - Trang - Nền) hay không."

#: sw/messages.po
msgctxt "printeroptions|pictures"
msgid "Images and other graphic objects"
msgstr "Ảnh và các đối tượng đồ họa khác"

#: sw/messages.po
msgctxt "printeroptions|extended_tip|pictures"
msgid "Specifies whether the graphics and drawings or OLE objects of your text document are printed."
msgstr "Chỉ định có in đồ họa, hình vẽ hoặc đối tượng OLE của tài liệu văn bản hay không."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|hiddentext"
msgid "Enable this option to print text that is marked as hidden."
msgstr "Bật tùy chọn này để in văn bản được đánh dấu là ẩn."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|placeholders"
msgid "Enable this option to print text placeholders. Disable this option to leave the text placeholders blank in the printout."
msgstr "Bật tùy chọn này để in phần giữ chỗ văn bản. Tắt tùy chọn này để để trống phần giữ chỗ văn bản trong bản in."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|formcontrols"
msgid "Specifies whether the form control fields of the text document are printed."
msgstr "Chỉ định có in các trường điều khiển biểu mẫu của tài liệu văn bản hay không."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|writercomments"
msgid "Specify where to print comments (if any)."
msgstr "Chỉ định nơi in chú thích (nếu có)."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|textinblack"
msgid "Specifies whether to always print text in black."
msgstr "Chỉ định có luôn in văn bản màu đen hay không."

#: sw/messages.po
msgctxt "printeroptions|extended_tip|autoblankpages"
msgid "If this option is enabled automatically inserted blank pages are printed. This is best if you are printing double-sided. For example, in a book, a \"chapter\" paragraph style has been set to always start with an odd numbered page. If the previous chapter ends on an odd page, Writer inserts an even numbered blank page. This option controls whether to print that even numbered page."
msgstr "Nếu bật tùy chọn này, các trang trống được chèn tự động sẽ được in. Nên bật khi in hai mặt. Ví dụ, trong một cuốn sách, kiểu đoạn văn \"chương\" được đặt luôn bắt đầu ở trang lẻ. Nếu chương trước kết thúc ở trang lẻ, Writer chèn một trang trống số chẵn. Tùy chọn này kiểm soát việc có in trang số chẵn đó hay không."

#: sw/messages.po
msgctxt "printmergedialog|PrintMergeDialog"
msgid "Your document contains address database fields. Do you want to print a form letter?"
msgstr "Tài liệu của bạn chứa các trường cơ sở dữ liệu địa chỉ. Bạn có muốn in thư hàng loạt không?"

#: sw/messages.po
msgctxt "printmonitordialog|PrintMonitorDialog"
msgid "Print monitor"
msgstr "Trình giám sát in"

#: sw/messages.po
msgctxt "printmonitordialog|printing"
msgid "is being prepared for printing on"
msgstr "đang được chuẩn bị để in trên"

#: sw/messages.po
msgctxt "extended_tip|graphics"
msgid "Specifies whether the graphics of your text document are printed."
msgstr "Chỉ định có in đồ họa của tài liệu văn bản hay không."

#: sw/messages.po
msgctxt "printoptionspage|extended_tip|background"
msgid "Specifies whether to include colors and objects that are inserted to the background of the page style (Format - Page Style - Area) in the printed document."
msgstr "Chỉ định có đưa vào bản in các màu và đối tượng được chèn vào nền của kiểu trang (Định dạng - Kiểu trang - Vùng) hay không."

#: sw/messages.po
msgctxt "extended_tip|leftpages"
msgid "Specifies whether to print all left (even numbered) pages of the document."
msgstr "Chỉ định có in tất cả các trang trái (số chẵn) của tài liệu hay không."

#: sw/messages.po
msgctxt "extended_tip|rightpages"
msgid "Specifies whether to print all right (odd numbered) pages of the document."
msgstr "Chỉ định có in tất cả các trang phải (số lẻ) của tài liệu hay không."

#: sw/messages.po
msgctxt "extended_tip|brochure"
msgid "Select the Brochure option to print your document in brochure format."
msgstr "Chọn tùy chọn Sách nhỏ để in tài liệu theo định dạng sách nhỏ."

#: sw/messages.po
msgctxt "printoptionspage|extended_tip|none"
msgid "Do not print document comments."
msgstr "Không in các chú thích của tài liệu."

#: sw/messages.po
msgctxt "printoptionspage|extended_tip|only"
msgid "Only print the comments of your document."
msgstr "Chỉ in các chú thích của tài liệu."

#: sw/messages.po
msgctxt "printoptionspage|extended_tip|end"
msgid "Print comments on a new page at end of the document."
msgstr "In chú thích trên một trang mới ở cuối tài liệu."

#: sw/messages.po
msgctxt "extended_tip|endpage"
msgid "Print comments on a new page after the current page."
msgstr "In chú thích trên một trang mới sau trang hiện tại."

#: sw/messages.po
msgctxt "printoptionspage|inmargins"
msgid "In margins"
msgstr "Trong lề"

#: sw/messages.po
msgctxt "printoptionspage|extended_tip|inmargins"
msgid "Include the comments boxes on the margin of the page. The page contents is rendered to fit both contents and the comments boxes."
msgstr "Đưa các hộp chú thích vào lề trang. Nội dung trang được dàn lại để vừa với cả nội dung và các hộp chú thích."

#: sw/messages.po
msgctxt "extended_tip|blankpages"
msgid "If this option is enabled, automatically-inserted blank pages are being printed. This is best if you are printing double-sided. For example, in a book, a \"chapter\" paragraph style has been set to always start with an odd numbered page. If the previous chapter ends on an odd page, Writer inserts an even numbered blank page. This option controls whether to print that even numbered page or not."
msgstr "Nếu bật tùy chọn này, các trang trống được chèn tự động sẽ được in. Tùy chọn này phù hợp khi in hai mặt. Ví dụ, trong một cuốn sách, kiểu đoạn văn \"chương\" được đặt để luôn bắt đầu ở trang số lẻ. Nếu chương trước kết thúc ở trang lẻ, Writer sẽ chèn một trang trống số chẵn. Tùy chọn này quy định có in trang số chẵn đó hay không."

#: sw/messages.po
msgctxt "extended_tip|papertray"
msgid "For printers with multiple trays, the \"Paper tray from printer settings\" option specifies whether the paper tray used is specified by the system settings of the printer."
msgstr "Với máy in có nhiều khay, tùy chọn \"Khay giấy theo cài đặt máy in\" quy định khay giấy được dùng có theo cài đặt hệ thống của máy in hay không."

