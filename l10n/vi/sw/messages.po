msgctxt "extended_tip|paragraph"
msgid "Specifies whether paragraph delimiters are displayed. The paragraph delimiters also contain paragraph format information."
msgstr "Xác định có hiển thị dấu phân cách đoạn văn hay không. Dấu phân cách đoạn văn cũng chứa thông tin định dạng của đoạn."

#: sw/messages.po
msgctxt "optformataidspage|hyphens"
msgid "Soft h_yphens"
msgstr "Dấu gạch nối _mềm"

#: sw/messages.po
msgctxt "extended_tip|hyphens"
msgid "Specifies whether soft hyphens (called also as optional or discretionary hyphens) are displayed. These are hidden user-defined delimiters that you enter within a word by pressing Ctrl+Hyphen(-). Words with soft hyphens are only separated at the end of a line at the point where a soft hyphen has been inserted, irrespective of whether the automatic hyphenation is activated or deactivated."
msgstr "Xác định có hiển thị dấu gạch nối mềm (còn gọi là dấu gạch nối tùy chọn) hay không. Đây là các dấu phân cách ẩn do người dùng nhập vào trong từ bằng cách nhấn Ctrl+Gạch nối (-). Từ có dấu gạch nối mềm chỉ bị ngắt ở cuối dòng tại vị trí đã chèn dấu gạch nối mềm, bất kể tính năng ngắt từ tự động đang bật hay tắt."

#: sw/messages.po
msgctxt "optformataidspage|spaces"
msgid "Spac_es"
msgstr "_Dấu cách"

#: sw/messages.po
msgctxt "extended_tip|spaces"
msgid "Specifies whether to represent every space in the text with a dot."
msgstr "Xác định có biểu diễn mỗi dấu cách trong văn bản bằng một dấu chấm hay không."

#: sw/messages.po
msgctxt "optformataidspage|nonbreak"
msgid "Non-breaking s_paces and hyphen"
msgstr "Dấu cách và gạch nối _không ngắt"

#: sw/messages.po
msgctxt "extended_tip|nonbreak"
msgid "Specifies that non-breaking spaces are shown as gray boxes. Non-breaking spaces are not broken at the end of a line and are entered with the Ctrl+Shift+Spacebar shortcut keys."
msgstr "Xác định hiển thị dấu cách không ngắt dưới dạng ô màu xám. Dấu cách không ngắt không bị ngắt ở cuối dòng và được nhập bằng phím tắt Ctrl+Shift+Phím cách."

#: sw/messages.po
msgctxt "optformataidspage|tabs"
msgid "_Tabs"
msgstr "_Tab"

#: sw/messages.po
msgctxt "extended_tip|tabs"
msgid "Specifies that tab stops are displayed as small arrows."
msgstr "Xác định hiển thị các điểm dừng tab dưới dạng mũi tên nhỏ."

#: sw/messages.po
msgctxt "optformataidspage|break"
msgid "Brea_ks"
msgstr "Dấu _ngắt"

#: sw/messages.po
msgctxt "extended_tip|break"
msgid "Displays all line breaks inserted with the Shift+Enter shortcut. These breaks create a new line, but do not start a new paragraph."
msgstr "Hiển thị mọi dấu ngắt dòng được chèn bằng phím tắt Shift+Enter. Các dấu ngắt này tạo dòng mới nhưng không bắt đầu đoạn văn mới."

