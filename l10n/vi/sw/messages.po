#: sw/messages.po
msgctxt "tocindexpage|combinesame"
msgid "Combine identical entries"
msgstr "Gộp các mục giống nhau"

#: sw/messages.po
msgctxt "tocindexpage|extended_tip|combinesame"
msgid "Replaces identical index entries with a single entry that lists the page numbers where the entry occurs in the document. For example, the entries “View 10, View 43” are combined as “View 10, 43”."
msgstr "Thay các mục chỉ mục giống nhau bằng một mục duy nhất liệt kê các số trang nơi mục đó xuất hiện trong tài liệu. Ví dụ, các mục \"View 10, View 43\" được gộp thành \"View 10, 43\"."

#: sw/messages.po
msgctxt "tocindexpage|useff"
msgid "Combine identical entries with f. or _ff."
msgstr "Gộp mục giống nhau bằng f. hoặc _ff."

#: sw/messages.po
msgctxt "tocindexpage|extended_tip|useff"
msgid "Replaces identical index entries that occur on the directly following page(s), with a single entry that lists the first page number and a “f” or “ff”. For example, the entries “View 10, View 11” are combined as “View 10f”, and “View 10, View 11, View 12” as “View 10ff”. Actual appearance depends on the locale setting, but can be overridden with Sort - Language."
msgstr "Thay các mục chỉ mục giống nhau xuất hiện ở các trang liền sau bằng một mục duy nhất liệt kê số trang đầu tiên kèm \"f\" hoặc \"ff\". Ví dụ, các mục \"View 10, View 11\" được gộp thành \"View 10f\", và \"View 10, View 11, View 12\" thành \"View 10ff\". Cách hiển thị thực tế phụ thuộc vào thiết lập ngôn ngữ, nhưng có thể bị ghi đè bằng Sắp xếp - Ngôn ngữ."

#: sw/messages.po
msgctxt "tocindexpage|usedash"
msgid "Combine with -"
msgstr "Gộp bằng -"

#: sw/messages.po
msgctxt "tocindexpage|extended_tip|usedash"
msgid "Replaces identical index entries that occur on consecutive pages with a single entry and the page range where the entry occurs. For example, the entries “View 10, View 11, View 12” are combined as “View 10-12”."
msgstr "Thay các mục chỉ mục giống nhau xuất hiện ở các trang liên tiếp bằng một mục duy nhất kèm phạm vi trang nơi mục đó xuất hiện. Ví dụ, các mục \"View 10, View 11, View 12\" được gộp thành \"View 10-12\"."

#: sw/messages.po
msgctxt "tocindexpage|casesens"
msgid "Case sensitive"
msgstr "Phân biệt hoa thường"

#: sw/messages.po
msgctxt "tocindexpage|extended_tip|casesens"
msgid "Distinguishes between uppercase and lowercase letters in otherwise identical index entries. For Asian languages special handling applies."
msgstr "Phân biệt chữ hoa và chữ thường trong các mục chỉ mục vốn giống hệt nhau. Với các ngôn ngữ châu Á, áp dụng cách xử lý đặc biệt."

