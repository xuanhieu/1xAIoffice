#: sw/messages.po
msgctxt "warndatasourcedialog|WarnDataSourceDialog"
msgid "The connection to the data source could not be established. Please check the connection settings."
msgstr "Không thể thiết lập kết nối đến nguồn dữ liệu. Vui lòng kiểm tra các thiết lập kết nối."

#: sw/messages.po
msgctxt "warndatasourcedialog|check"
msgid "Check Connection Settings..."
msgstr "Kiểm tra thiết lập kết nối..."

#: sw/messages.po
msgctxt "warnemaildialog|WarnEmailDialog"
msgid "Emails could not be sent"
msgstr "Không thể gửi email"

#: sw/messages.po
msgctxt "warnemaildialog|WarnEmailDialog"
msgid "The following error occurred:"
msgstr "Đã xảy ra lỗi sau:"

#: sw/messages.po
msgctxt "warnhiddensectiondialog|WarnHiddenSectionDialog"
msgid "Delete hidden section(s)?"
msgstr "Xóa các phần ẩn?"

#: sw/messages.po
msgctxt "warnhiddensectiondialog|WarnHiddenSectionDialog"
msgid "Would you like to delete the hidden section(s)?"
msgstr "Bạn có muốn xóa các phần ẩn không?"

#: sw/messages.po
msgctxt "warnhiddensectiondialog|WarnHiddenSectionDialog"
msgid "There are hidden sections in the deleted area."
msgstr "Có các phần ẩn trong vùng bị xóa."

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|TextInput"
msgid "Enter the watermark text to be displayed as image in the page background."
msgstr "Nhập văn bản hình mờ để hiển thị dưới dạng ảnh ở nền trang."

#: sw/messages.po
msgctxt "watermarkdialog|TransparencyLabel"
msgid "Transparency"
msgstr "Độ trong suốt"

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|Angle"
msgid "Select the rotation angle for the watermark. The text will be rotated by this angle in counterclockwise direction."
msgstr "Chọn góc xoay cho hình mờ. Văn bản sẽ xoay theo góc này ngược chiều kim đồng hồ."

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|Transparency"
msgid "Select the transparency level for the watermark. A 0% value produces an opaque watermark and a value of 100% is totally transparent (invisible)."
msgstr "Chọn mức trong suốt cho hình mờ. Giá trị 0% tạo hình mờ đục hoàn toàn, còn giá trị 100% là trong suốt hoàn toàn (không nhìn thấy)."

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|Color"
msgid "Select a color from the drop-down box."
msgstr "Chọn một màu từ hộp thả xuống."

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|FontBox"
msgid "Select the font from the list."
msgstr "Chọn phông chữ từ danh sách."

#: sw/messages.po
msgctxt "watermarkdialog|extended_tip|WatermarkDialog"
msgid "Insert a watermark text in the current page style background."
msgstr "Chèn văn bản hình mờ vào nền của kiểu trang hiện tại."

#: sw/messages.po
msgctxt "wordcount|cjkcharsft"
msgid "Asian characters and Korean words"
msgstr "Ký tự châu Á và từ tiếng Hàn"

#: sw/messages.po
msgctxt "wordcount|standardizedpages"
msgid "Standardized pages"
msgstr "Trang chuẩn hóa"

#: sw/messages.po
msgctxt "wordcount|label_cursor"
msgid "Words before/after cursor"
msgstr "Số từ trước/sau con trỏ"

#: sw/messages.po
msgctxt "wrapdialog|WrapDialog"
msgid "Wrap"
msgstr "Bao quanh văn bản"

#: sw/messages.po
msgctxt "wrapdialog|extended_tip|WrapDialog"
msgid "Specify the way you want text to wrap around an object."
msgstr "Chỉ định cách bạn muốn văn bản bao quanh một đối tượng."

#: sw/messages.po
msgctxt "wrappage|before"
msgid "Be_fore"
msgstr "_Trước"

#: sw/messages.po
msgctxt "wrappage|extended_tip|before"
msgid "Wraps text on the left side of the object if there is enough space."
msgstr "Bao văn bản ở bên trái đối tượng nếu đủ chỗ."

#: sw/messages.po
msgctxt "wrappage|after"
msgid "Aft_er"
msgstr "S_au"

#: sw/messages.po
msgctxt "wrappage|extended_tip|after"
msgid "Wraps text on the right side of the object if there is enough space."
msgstr "Bao văn bản ở bên phải đối tượng nếu đủ chỗ."

#: sw/messages.po
msgctxt "wrappage|parallel"
msgid "_Parallel"
msgstr "Song _song"

#: sw/messages.po
msgctxt "wrappage|extended_tip|parallel"
msgid "Wraps text on all four sides of the border frame of the object."
msgstr "Bao văn bản ở cả bốn phía của khung viền đối tượng."

#: sw/messages.po
msgctxt "wrappage|through"
msgid "Thro_ugh"
msgstr "Xuy_ên suốt"

#: sw/messages.po
msgctxt "wrappage|extended_tip|through"
msgid "Places the object in front of the text."
msgstr "Đặt đối tượng ở phía trước văn bản."

#: sw/messages.po
msgctxt "wrappage|none"
msgid "_Wrap Off"
msgstr "_Tắt bao quanh"

#: sw/messages.po
msgctxt "wrappage|extended_tip|none"
msgid "Places the object on a separate line in the document. The Text in the document appears above and below the object, but not on the sides of the object."
msgstr "Đặt đối tượng trên một dòng riêng trong tài liệu. Văn bản trong tài liệu xuất hiện phía trên và phía dưới đối tượng, không xuất hiện ở hai bên."

#: sw/messages.po
msgctxt "wrappage|optimal"
msgid "_Optimal"
msgstr "_Tối ưu"

#: sw/messages.po
msgctxt "wrappage|extended_tip|optimal"
msgid "Automatically wraps text to the left, to the right, or on all four sides of the border frame of the object. If the distance between the object and the page margin is less than 2 cm, the text is not wrapped."
msgstr "Tự động bao văn bản ở bên trái, bên phải hoặc cả bốn phía của khung viền đối tượng. Nếu khoảng cách giữa đối tượng và lề trang nhỏ hơn 2 cm, văn bản sẽ không được bao quanh."

#: sw/messages.po
msgctxt "wrappage|label4"
msgid "L_eft:"
msgstr "_Trái:"

#: sw/messages.po
msgctxt "wrappage|label5"
msgid "_Right:"
msgstr "_Phải:"

#: sw/messages.po
msgctxt "wrappage|label6"
msgid "_Top:"
msgstr "_Trên:"

#: sw/messages.po
msgctxt "wrappage|label7"
msgid "_Bottom:"
msgstr "_Dưới:"

#: sw/messages.po
msgctxt "wrappage|anchoronly"
msgid "_First paragraph"
msgstr "Đoạn văn đầ_u tiên"

#: sw/messages.po
msgctxt "wrappage|extended_tip|anchoronly"
msgid "Starts a new paragraph below the object after you press Enter."
msgstr "Bắt đầu một đoạn văn mới bên dưới đối tượng sau khi bạn nhấn Enter."

#: sw/messages.po
msgctxt "wrappage|transparent"
msgid "In bac_kground"
msgstr "Ở _nền"

#: sw/messages.po
msgctxt "wrappage|extended_tip|transparent"
msgid "Moves the selected object to the background. This option is only available if you selected the Through wrap type."
msgstr "Chuyển đối tượng đã chọn xuống nền. Tùy chọn này chỉ có khi bạn chọn kiểu bao quanh Xuyên suốt."

#: sw/messages.po
msgctxt "wrappage|outline"
msgid "_Contour"
msgstr "_Đường viền"

#: sw/messages.po
msgctxt "wrappage|extended_tip|outline"
msgid "Wraps text around the shape of the object. This option is not available for the Through wrap type, or for frames."
msgstr "Bao văn bản quanh hình dạng của đối tượng. Tùy chọn này không có với kiểu bao quanh Xuyên suốt, hoặc với khung."

#: sw/messages.po
msgctxt "wrappage|outside"
msgid "Outside only"
msgstr "Chỉ bên ngoài"

#: sw/messages.po
msgctxt "wrappage|outside"
msgid "Allow overlap"
msgstr "Cho phép chồng lấp"

#: sw/messages.po
msgctxt "wrappage|extended_tip|WrapPage"
msgid "Specify the way you want text to wrap around an object."
msgstr "Chỉ định cách bạn muốn văn bản bao quanh một đối tượng."

